{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arcana",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "ENVIRONMENT": "production",
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // database_id を空にすると、デプロイ時に D1 / R2 を自動作成する。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arcana",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "arcana-files",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "Y_DURABLE_OBJECTS",
        "class_name": "PageRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PageRoom"],
    },
  ],
  // 1環境 = 1 Worker + 1 D1 + 1 R2 + 1 DO 名前空間。staging と production は混ぜない。
  "env": {
    "staging": {
      "name": "arcana-staging",
      "vars": { "ENVIRONMENT": "staging" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "arcana-staging",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "arcana-files-staging",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "Y_DURABLE_OBJECTS",
            "class_name": "PageRoom",
          },
        ],
      },
    },
    "production": {
      "name": "arcana-production",
      "vars": { "ENVIRONMENT": "production" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "arcana-production",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "arcana-files-production",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "Y_DURABLE_OBJECTS",
            "class_name": "PageRoom",
          },
        ],
      },
    },
  },
}
